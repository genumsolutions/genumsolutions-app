# Local agent scratch artifacts under apk/ — never commit.
release.json

# Debug APKs (large build artifacts; keep release APKs tracked)
*-debug*.apk

# Local rebuilds for on-device testing - never commit
*-local-test.apk

# Mirrored release APKs are reproducible with root-apk-sync.mjs; the bucket is
# the source of truth, so the 40 MB binaries stay out of git.
genum-solutions-*.apk
