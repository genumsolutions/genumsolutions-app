{
  "expo": {
    "name": "GENUM Solutions",
    "slug": "genum-solutions",
    "scheme": "genumsolutions",
    "version": "1.5.7",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.genumsolutions.app",
      "versionCode": 15,
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-secure-store-backup.js",
      "./plugins/with-install-permission.js",
      "./plugins/with-release-signing.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e3a8a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      ["@react-native-google-signin/google-signin", { "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER" }],
      [
        "@sfourdrinier/react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Allow GENUM Solutions to connect to your robot car over Bluetooth so you can drive it from the app."
        }
      ]
    ]
  }
}